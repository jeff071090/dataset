+@override_settings(ALLOWED_HOSTS=["*"])
+class SabadoDiaDeCompraTestCase(TestCase):
+    def setUp(self):
+        self.empresa, self.filial = _empresa("Farmácia G", "77.000.333/0001-07")
+
+    def test_opcao_desligada_mantem_segunda_a_sexta(self):
+        from finance_engine.calendario_operacional import dias_uteis_operacionais
+        # Outubro/2026: 22 dias de segunda a sexta e 5 sábados.
+        self.assertEqual(dias_uteis_operacionais(self.empresa, 2026, 10), 22)
+
+    def test_opcao_ligada_conta_os_sabados(self):
+        from finance_engine.calendario_operacional import dia_conta_capacidade, dias_uteis_operacionais, tipo_do_dia
+        self.empresa.sabado_dia_de_compra = True
+        self.empresa.save()
+        self.assertEqual(dias_uteis_operacionais(self.empresa, 2026, 10), 27)
+        self.assertTrue(dia_conta_capacidade(tipo_do_dia(self.empresa, date(2026, 10, 17))))
+        self.assertFalse(dia_conta_capacidade(tipo_do_dia(self.empresa, date(2026, 10, 18))))  # domingo
+
+    def test_sabado_ligado_recebe_limite_no_motor(self):
+        from finance_engine.services import motor_financeiro
+        ConfiguracaoFinanceira.objects.create(empresa=self.empresa, percentual_compras=Decimal("50"))
+        Receita.objects.create(filial=self.filial, mes=date(2026, 10, 1), faturamento=Decimal("100000"))
+        self.empresa.sabado_dia_de_compra = True
+        self.empresa.save()
+        posicoes = motor_financeiro.calcular_posicoes_do_mes(self.filial, 2026, 10)
+        sabado = next(p for p in posicoes if p.data == date(2026, 10, 17))
+        self.assertGreater(sabado.limite_efetivo, 0)
+
+    def test_tela_liga_e_desliga_com_auditoria(self):
+        dono = Usuario.objects.create_user(username="dono_g", password=SENHA,
+                                           perfil=Usuario.Perfil.PROPRIETARIO, empresa=self.empresa)
+        self.client.force_login(dono)
+        self.client.post("/financeiro/calendario-operacional/", {"acao": "sabado", "sabado_dia_de_compra": "1"})
+        self.empresa.refresh_from_db()
+        self.assertTrue(self.empresa.sabado_dia_de_compra)
+        self.assertTrue(RegistroAuditoria.objects.filter(empresa=self.empresa, acao="sabado_dia_de_compra").exists())
+        self.assertContains(self.client.get("/financeiro/calendario-operacional/"), "Ligado: sábado é dia de compra")
+        self.client.post("/financeiro/calendario-operacional/", {"acao": "sabado", "sabado_dia_de_compra": "0"})
+        self.empresa.refresh_from_db()
+        self.assertFalse(self.empresa.sabado_dia_de_compra)
+
