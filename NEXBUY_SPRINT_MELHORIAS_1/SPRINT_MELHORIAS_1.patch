+"""Sprint de Melhorias 1 — segurança e usabilidade, sem mudar a essência do
+NEXBUY (limite de compra do dia, aprovação e análise do mês).
+
+Cada classe trava uma melhoria:
+- CSV sem fórmula do Excel;
+- Assistente de Implantação só para o suporte;
+- conta do suporte e perfil global fora do alcance do cliente;
+- senha inicial com as regras completas;
+- limite de tentativas de login;
+- troca de empresa sem redirecionar para outro site;
+- histórico de compras paginado;
+- "Sábado é dia de compra";
+- alertas e recomendações honestos quando falta lançamento.
+"""
+from datetime import date, timedelta
+from decimal import Decimal
+
+from django.test import Client, TestCase
+from django.test.utils import override_settings
+from django.utils import timezone
+
+from auditoria.models import RegistroAuditoria
+from cadastros.models import Categoria
+from compras.models import Compra, Fornecedor
+from core.relatorios import celula_segura, resposta_csv
+from empresas.models import Empresa
+from filiais.models import Filial
+from financeiro.models import ConfiguracaoFinanceira, Receita
+from usuarios.models import PerfilAcesso, Permissao, Usuario
+
+SENHA = "Farmacia#Forte2026"
+
+
+def _empresa(nome, cnpj):
+    empresa = Empresa.objects.create(nome=nome, cnpj=cnpj)
+    filial = Filial.objects.create(empresa=empresa, nome="Matriz")
+    return empresa, filial
+
+
+class CsvSemFormulaTestCase(TestCase):
+    def test_celula_que_comeca_com_formula_ganha_apostrofo(self):
+        for perigosa in ("=HYPERLINK(\"http://x\";\"clique\")", "+1+1", "@SOMA(A1)", "-2+3", "\t=1"):
+            self.assertTrue(celula_segura(perigosa).startswith("'"), perigosa)
+
+    def test_numeros_e_textos_comuns_nao_mudam(self):
+        for comum in ("-3.300,00", "1.500,00", "-15", "Juliana Ramos", "", "Medicamentos"):
+            self.assertEqual(celula_segura(comum), comum)
+        self.assertEqual(celula_segura(Decimal("10")), Decimal("10"))
+
+    def test_resposta_csv_aplica_a_protecao(self):
+        conteudo = resposta_csv("x.csv", ["Nome"], [["=1+1"], ["-10,00"]]).content.decode("utf-8-sig")
+        self.assertIn("'=1+1", conteudo)
+        self.assertIn("-10,00", conteudo)
+        self.assertNotIn("'-10,00", conteudo)
+
+
+@override_settings(ALLOWED_HOSTS=["*"])
+class AssistenteSoParaSuporteTestCase(TestCase):
+    def setUp(self):
+        self.empresa, self.filial = _empresa("Farmácia A", "11.444.777/0001-61")
+        self.proprietario = Usuario.objects.create_user(
+            username="dono_a", password=SENHA, perfil=Usuario.Perfil.PROPRIETARIO, empresa=self.empresa,
+        )
+        self.suporte = Usuario.objects.create_user(
+            username="suporte", password=SENHA, perfil=Usuario.Perfil.PROPRIETARIO, empresa=self.empresa,
+            is_superuser=True, is_staff=True,
+        )
+
+    def test_proprietario_nao_abre_o_assistente(self):
+        self.client.force_login(self.proprietario)
+        self.assertEqual(self.client.get("/ncc/implantacao/").status_code, 403)
+        self.assertEqual(self.client.post("/ncc/implantacao/", {"acao": "avancar"}).status_code, 403)
+
+    def test_proprietario_nao_ve_o_atalho_do_assistente(self):
+        self.client.force_login(self.proprietario)
+        self.assertNotContains(self.client.get("/ncc/"), "/ncc/implantacao/")
+
+    def test_suporte_continua_usando_o_assistente(self):
+        self.client.force_login(self.suporte)
+        self.assertEqual(self.client.get("/ncc/implantacao/").status_code, 200)
+        self.assertContains(self.client.get("/ncc/"), "/ncc/implantacao/")
+
+
+@override_settings(ALLOWED_HOSTS=["*"])
+class ContaDoSuporteEPerfilGlobalTestCase(TestCase):
+    def setUp(self):
+        self.empresa, self.filial = _empresa("Farmácia B", "22.555.888/0001-02")
+        self.proprietario = Usuario.objects.create_user(
+            username="dono_b", password=SENHA, perfil=Usuario.Perfil.PROPRIETARIO, empresa=self.empresa,
