+class LimiteDeTentativasDeLoginTestCase(TestCase):
+    def setUp(self):
+        self.empresa, self.filial = _empresa("Farmácia D", "44.777.000/0001-04")
+        Usuario.objects.create_user(username="juliana", password=SENHA, perfil=Usuario.Perfil.COMPRADOR,
+                                    empresa=self.empresa, filial=self.filial)
+        Usuario.objects.create_user(username="pedro", password=SENHA, perfil=Usuario.Perfil.COMPRADOR,
+                                    empresa=self.empresa, filial=self.filial)
+
+    def _login(self, username, senha, ip="45.10.0.1"):
+        return Client(REMOTE_ADDR=ip).post("/accounts/login/", {"username": username, "password": senha})
+
+    def test_cinco_falhas_pausam_o_usuario_mesmo_com_a_senha_certa(self):
+        for _ in range(5):
+            self.assertEqual(self._login("juliana", "errada").status_code, 200)
+        resposta = self._login("juliana", SENHA)
+        self.assertEqual(resposta.status_code, 200)
+        self.assertContains(resposta, "Muitas tentativas de login")
+
+    def test_outro_usuario_nao_e_afetado(self):
+        for _ in range(5):
+            self._login("juliana", "errada", ip="45.10.0.2")
+        self.assertEqual(self._login("pedro", SENHA, ip="45.10.0.3").status_code, 302)
+
+    def test_bloqueio_acaba_depois_da_janela(self):
+        for _ in range(5):
+            self._login("juliana", "errada")
+        RegistroAuditoria.objects.filter(categoria=RegistroAuditoria.Categoria.LOGIN_FALHO).update(
+            criado_em=timezone.now() - timedelta(days=1)
+        )
+        self.assertEqual(self._login("juliana", SENHA).status_code, 302)
+
+    def test_ip_com_muitas_falhas_e_pausado(self):
+        for i in range(20):
+            self._login(f"inexistente{i}", "errada", ip="45.9.9.9")
+        self.assertContains(self._login("pedro", SENHA, ip="45.9.9.9"), "Muitas tentativas de login")
+        self.assertEqual(self._login("pedro", SENHA, ip="45.10.0.4").status_code, 302)
+
+    def test_ip_interno_de_balanceador_nunca_pausa_o_site_inteiro(self):
+        # PythonAnywhere: todos chegam com o IP interno do balanceador.
+        for i in range(25):
+            self._login(f"inexistente{i}", "errada", ip="10.0.0.9")
+        self.assertEqual(self._login("pedro", SENHA, ip="10.0.0.9").status_code, 302)
+
