   .nx-nav .nx-nav-sublink,
   .nx-nav .nx-nav-caret { transition: none; }
 }
+
+/* ==========================================================================
+   Sprint de Melhorias 1 (usabilidade no celular)
+   ========================================================================== */
+
+/* Tabelas de decisão viram cartões no celular: cada linha é um cartão com
+   "Rótulo: valor" e os botões Aprovar/Rejeitar/Decidir sempre à vista.
+   Antes a tabela passava da largura da tela e cortava o valor e o botão —
+   justo a ação que a proprietária mais faz pelo celular.
+   Uso: <table class="... nx-tabela-cartoes"> + <td data-label="Valor">. */
+@media (max-width: 575.98px) {
+  .nx-tabela-cartoes thead { display: none; }
+  .nx-tabela-cartoes,
+  .nx-tabela-cartoes tbody,
+  .nx-tabela-cartoes tr,
+  .nx-tabela-cartoes td { display: block; width: 100%; }
+  .nx-tabela-cartoes tr {
+    border-bottom: 1px solid var(--nx-gray-200, #e5e7eb);
+    padding: .5rem 0;
+  }
+  .nx-tabela-cartoes td {
+    display: flex; justify-content: space-between; align-items: center; gap: .75rem;
+    border: 0; padding: .3rem 1rem; text-align: right !important;
+  }
+  .nx-tabela-cartoes td[data-label]::before {
+    content: attr(data-label);
+    font-size: .8rem; font-weight: 600; color: var(--nx-gray-500, #6b7280); text-align: left;
+  }
+  .nx-tabela-cartoes td.nx-celula-acoes { justify-content: flex-end; gap: .5rem; padding-top: .5rem; }
+  .nx-tabela-cartoes td.nx-celula-acoes .btn { min-height: 40px; }
+}
+
+/* Valores dos cartões de indicador nunca quebram no meio ("R$ 452." numa
+   linha e "908" na outra): no celular a fonte se ajusta à largura. */
+.nx-kpi-value { white-space: nowrap; }
+@media (max-width: 575.98px) {
+  .nx-kpi-value { font-size: clamp(1.05rem, 5.2vw, 1.65rem); }
+}
